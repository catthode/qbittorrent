/* Catthode for qBittorrent — From CRT to OLED */

QWidget {
  background-color: #000000;
  color: #ffffff;
  selection-background-color: #ff9e3b;
  selection-color: #000000;
}

QMainWindow, QDialog {
  background-color: #000000;
}

QMenuBar, QMenu, QToolBar, QStatusBar, QDockWidget::title {
  background-color: #141414;
  color: #ffffff;
}

QMenuBar::item:selected, QMenu::item:selected {
  background-color: #2d2d2d;
  color: #fae2c8;
}

QMenu::separator {
  background-color: #2d2d2d;
  height: 1px;
  margin: 5px 8px;
}

QToolBar {
  border: 0;
  border-bottom: 1px solid #2d2d2d;
  spacing: 4px;
  padding: 3px;
}

QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 4px;
}

QToolButton:hover, QToolButton:checked {
  background-color: #2d2d2d;
  border-color: #636363;
}

QPushButton {
  background-color: #141414;
  border: 1px solid #636363;
  border-radius: 5px;
  color: #ffffff;
  min-height: 24px;
  padding: 3px 12px;
}

QPushButton:hover, QPushButton:focus {
  border-color: #ff9e3b;
  color: #fae2c8;
}

QPushButton:pressed {
  background-color: #2d2d2d;
}

QPushButton:disabled {
  border-color: #2d2d2d;
  color: #757575;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QDateTimeEdit, QComboBox {
  background-color: #141414;
  border: 1px solid #636363;
  border-radius: 4px;
  color: #ffffff;
  min-height: 24px;
  padding: 2px 6px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #ff9e3b;
}

QComboBox::drop-down {
  border: 0;
  width: 22px;
}

QComboBox QAbstractItemView {
  background-color: #141414;
  border: 1px solid #636363;
  color: #ffffff;
  selection-background-color: #2d2d2d;
  selection-color: #fae2c8;
}

QAbstractItemView {
  background-color: #000000;
  alternate-background-color: #141414;
  border: 0;
  color: #ffffff;
  outline: 0;
  selection-background-color: #2d2d2d;
  selection-color: #fae2c8;
}

QAbstractItemView::item:hover {
  background-color: #1e1e1e;
}

QHeaderView::section {
  background-color: #141414;
  border: 0;
  border-right: 1px solid #2d2d2d;
  border-bottom: 1px solid #2d2d2d;
  color: #d9b98c;
  padding: 5px;
}

QTabWidget::pane {
  border: 1px solid #2d2d2d;
}

QTabBar::tab {
  background-color: #141414;
  border: 0;
  border-bottom: 2px solid transparent;
  color: #b3b3b3;
  min-width: 72px;
  padding: 7px 12px;
}

QTabBar::tab:hover {
  color: #fae2c8;
}

QTabBar::tab:selected {
  background-color: #000000;
  border-bottom-color: #ff9e3b;
  color: #ffffff;
}

QGroupBox {
  border: 1px solid #2d2d2d;
  border-radius: 5px;
  margin-top: 12px;
  padding-top: 8px;
}

QGroupBox::title {
  color: #fae2c8;
  left: 8px;
  padding: 0 4px;
  subcontrol-origin: margin;
}

QCheckBox, QRadioButton {
  spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
  background-color: #141414;
  border: 1px solid #636363;
  height: 14px;
  width: 14px;
}

QCheckBox::indicator {
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  background-color: #ff9e3b;
  border-color: #ffb86c;
}

QProgressBar {
  background-color: #141414;
  border: 1px solid #2d2d2d;
  border-radius: 4px;
  color: #ffffff;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #ff9e3b;
  border-radius: 3px;
}

QScrollBar:vertical {
  background-color: #000000;
  margin: 0;
  width: 12px;
}

QScrollBar:horizontal {
  background-color: #000000;
  height: 12px;
  margin: 0;
}

QScrollBar::handle {
  background-color: #636363;
  border-radius: 5px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background-color: #ff9e3b;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
  border: 0;
}

QSplitter::handle {
  background-color: #2d2d2d;
}

QToolTip {
  background-color: #141414;
  border: 1px solid #636363;
  color: #ffffff;
  padding: 4px;
}

QLabel[accessibleName="error"] {
  color: #ff6b6b;
}

/* Additional Qt surfaces covered by current qBittorrent releases. */
QMenuBar::item {
  padding: 4px 8px;
}

QMenuBar::item:pressed,
QMenu::item:pressed {
  background-color: #3a2a1c;
  color: #fae2c8;
}

QMenu {
  border: 1px solid #636363;
  border-radius: 4px;
  padding: 4px;
}

QMenu::item {
  border-radius: 4px;
  padding: 4px 22px 4px 8px;
}

QMenu::icon {
  padding: 0 5px;
}

QMenu::indicator {
  height: 16px;
  width: 16px;
  left: 5px;
}

QStatusBar::item {
  border: 0;
  padding: 4px;
}

QStatusBar QLabel,
QStatusBar QWidget,
QStatusBar QPushButton,
QStatusBar QPushButton:active {
  background-color: #141414;
}

QToolBar QToolButton {
  background-color: #141414;
  border-radius: 4px;
  padding: 5px;
}

QToolBar QToolButton:hover,
QToolBar QToolButton:checked {
  background-color: #2d2d2d;
}

QToolBar::separator {
  background-color: #2d2d2d;
  width: 1px;
  margin: 4px 0;
}

QLineEdit QToolButton,
QLineEdit QToolButton:hover {
  background-color: transparent;
  border: 0;
  margin-right: 2px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
  border-color: #ffb86c;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
  background-color: #0a0a0a;
  border-color: #2d2d2d;
  color: #757575;
}

QListView {
  background-color: #141414;
  border-radius: 4px;
  outline: 0;
}

QListView::item {
  border-radius: 4px;
  padding: 4px;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
  background-color: #1e1e1e;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
  background-color: #2d2d2d;
  color: #fae2c8;
}

QTreeView,
QTreeView::item,
QTableView {
  background-color: #000000;
}

QTreeView QScrollBar:horizontal,
QTreeView QScrollBar:vertical,
QTableView QScrollBar:horizontal,
QTableView QScrollBar:vertical {
  background-color: #000000;
}

QTableView QLabel,
QTableView QCheckBox {
  background-color: #141414;
  padding: 0 5px;
}

QTableView QSpinBox,
QTableView QComboBox,
QTableView QLineEdit,
QTableView QAbstractSpinBox {
  background-color: #141414;
  border-radius: 0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  background: transparent;
  border: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: transparent;
  border: 0;
}

QScrollBar::handle:pressed {
  background-color: #ffb86c;
  border-color: #ffb86c;
}

QPushButton:checked {
  background-color: #3a2a1c;
  border-color: #ff9e3b;
  color: #fae2c8;
}

QToolButton:pressed {
  background-color: #141414;
}

QToolButton:disabled {
  background-color: #0a0a0a;
  color: #757575;
}

QComboBox:hover {
  border-color: #ffb86c;
}

QComboBox:disabled {
  background-color: #0a0a0a;
  color: #757575;
}

QComboBox::drop-down {
  background-color: #141414;
  border: 0;
  width: 22px;
}

QComboBox QAbstractItemView {
  background-color: #141414;
  border: 1px solid #636363;
  padding: 3px 0;
}

QAbstractSpinBox:hover {
  border-color: #ffb86c;
}

QAbstractSpinBox:focus {
  background-color: #2d2d2d;
  border-color: #ff9e3b;
}

QAbstractSpinBox:disabled {
  background-color: #0a0a0a;
  border-color: #2d2d2d;
  color: #757575;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
  border-radius: 3px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
  background-color: #2d2d2d;
}

QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
  background-color: #141414;
}

QSlider {
  background-color: #141414;
}

QSlider::groove:horizontal,
QSlider::groove:vertical {
  background-color: #141414;
  border: 0;
  border-radius: 2px;
}

QSlider::groove:horizontal {
  height: 4px;
}

QSlider::groove:vertical {
  width: 4px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
  background-color: #ff9e3b;
  border: 0;
  border-radius: 5px;
  height: 10px;
  width: 10px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
  background-color: #ffb86c;
}

QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
  background-color: #f08d49;
  border-radius: 2px;
}

QRadioButton::indicator:unchecked {
  background-color: #141414;
  border: 1px solid #636363;
}

QRadioButton::indicator:checked {
  background-color: #ff9e3b;
  border: 1px solid #ffb86c;
}
